      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 5, "pointSize": 2 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "vibration" }, "properties": [{ "id": "color", "value": { "fixedColor": "#e74c3c", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "temperature" }, "properties": [{ "id": "color", "value": { "fixedColor": "#e67e22", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "current" }, "properties": [{ "id": "color", "value": { "fixedColor": "#3498db", "mode": "fixed" } }] }
